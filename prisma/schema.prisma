generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(cuid())
  username             String                @unique
  email                String                @unique
  role                 Role                  @default(GUEST)
  hash                 String
  salt                 String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  items                Item[]
  userMarketplaceAuths UserMarketplaceAuth[]
}

model Item {
  id             String    @id @default(cuid())
  title          String?
  description    String?
  brand          String?
  category       String?
  size           String?
  color          String?
  condition      String?
  material       String?
  estimatedPrice Decimal?  @db.Decimal(10, 2)
  aiIdentified   Boolean   @default(false)
  aiData         Json? // stores full AI response with confidence + reasoning
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  authorId       String
  images         Image[]
  author         User      @relation(fields: [authorId], references: [id])
  tags           ItemTag[]
  listings       Listing[]
}

model Image {
  id        String   @id @default(cuid())
  itemId    String
  url       String
  fileName  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Listing {
  id            String        @id @default(cuid())
  itemId        String
  marketplaceId String
  externalId    String?
  title         String
  description   String
  listingPrice  Decimal?      @db.Decimal(10, 2)
  status        ListingStatus @default(DRAFT)
  listedAt      DateTime?
  soldAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  marketplace   Marketplace   @relation(fields: [marketplaceId], references: [id])
  flagged       Boolean       @default(false)
  externalUrl   String?
}

model Marketplace {
  id                   String                @id @default(cuid())
  name                 String                @unique
  slug                 String                @unique
  type                 MarketplaceType       @default(TEMPLATE)
  listingUrl           String? // base URL to open when user clicks list
  createdAt            DateTime              @default(now())
  listings             Listing[]
  userMarketplaceAuths UserMarketplaceAuth[]
}

enum MarketplaceType {
  API // eBay — full programmatic integration
  TEMPLATE // copy-paste with link to listing page
}

model UserMarketplaceAuth {
  id            String   @id @default(cuid())
  userId        String
  marketplaceId String
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplace Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@unique([userId, marketplaceId])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  items ItemTag[]
}

model ItemTag {
  itemId String
  tagId  String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

enum Role {
  GUEST
  MEMBER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  SOLD
  EXPIRED
  REMOVED
}
